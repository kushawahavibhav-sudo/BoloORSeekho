.score{font:800 5.5rem/1 "Bricolage Grotesque",sans-serif;background:linear-gradient(100deg,#14b8ee,#e5399f);-webkit-background-clip:text;background-clip:text;color:transparent}
.mic{width:92px;height:92px;border-radius:50%;border:0;cursor:pointer;background:linear-gradient(135deg,#34d4ff,#a07bff);color:#14104a;font-size:2.1rem;box-shadow:0 14px 34px -8px rgba(111,69,240,.6);flex:none;transition:transform .25s cubic-bezier(.3,1.6,.5,1)}
