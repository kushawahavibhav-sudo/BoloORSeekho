let CURA=null,GEN=0;
function stopAll(){GEN++;try{speechSynthesis.cancel()}catch(e){}if(CURA){try{CURA.pause()}catch(e){}CURA=null}}
const chunks=t=>{const out=[];(t.match(/[^.!?\u0964\u06D4\u3002\uFF01\uFF1F\n]+[.!?\u0964\u06D4\u3002\uFF01\uFF1F]*/g)||[t]).forEach(p=>{p=p.trim();while(p.length>180){let i=p.lastIndexOf(' ',180);if(i<60)i=180;out.push(p.slice(0,i));p=p.slice(i).trim()}if(p)out.push(p)});return out};
const GT={zh:'zh-CN',he:'iw',fil:'tl'};
function onlineSay(t,l,r,onfail){
  const lg=l.split('-')[0].toLowerCase(),tl=GT[lg]||lg,parts=chunks(t),my=GEN;let i=0;
  const next=()=>{if(my!==GEN||i>=parts.length)return;
    const a=new Audio('https://translate.google.com/translate_tts?ie=UTF-8&client=tw-ob&tl='+encodeURIComponent(tl)+'&q='+encodeURIComponent(parts[i++]));
    a.playbackRate=r;CURA=a;a.onended=next;
    a.onerror=()=>{if(my===GEN){CURA=null;onfail()}};
    const pr=a.play();if(pr&&pr.catch)pr.catch(()=>{if(my===GEN){CURA=null;onfail()}})};
  next()}
const say=(t,l,r=1,p=1)=>{
  const hasSS='speechSynthesis' in window;
  if(hasSS)loadV();
  const v=hasSS?pick(l):null,was=hasSS&&(speechSynthesis.speaking||speechSynthesis.pending);
  stopAll();
  const device=()=>{
    if(!hasSS){toast('Voice could not play. Check your internet connection.');return}
    try{
      const sy=speechSynthesis,u=new SpeechSynthesisUtterance(t);
      if(v){u.voice=v;u.lang=v.lang}else u.lang=l;
      u.rate=r;u.pitch=p;
      u.onerror=ev=>{if(ev.error!=='canceled'&&ev.error!=='interrupted')toast('Could not play the voice. Check your volume.')};
      setTimeout(()=>{sy.resume();sy.speak(u)},was?120:0);
    }catch(e){toast('Voice could not start.')}
  };
  if(v)device();
  else onlineSay(t,l,r,()=>{toast('Online voice needs internet. Trying your device voice.');device()});
};

