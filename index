body{margin:0;background:transparent;color:var(--text);font:400 17px/1.6 Figtree,system-ui,sans-serif;min-height:100vh}
.bg{position:fixed;inset:0;z-index:-1;overflow:hidden;background:radial-gradient(120% 70% at 50% -10%,rgba(255,255,255,.85),transparent 60%),radial-gradient(rgba(60,70,150,.07) 1px,transparent 1.3px) 0 0/32px 32px,linear-gradient(135deg,var(--g1),var(--g2) 50%,var(--g3))}
