function evaluate(said){
  const t=norm(S[lang].list[idx]),s=norm(said),sw=s.split(' ');
  const marks=t.split(' ').map(w=>sw.includes(w));
  const score=Math.max(0,Math.round((1-lev(t,s)/Math.max(t.length,s.length,1))*100));
  showTarget(marks);lastScore=score;const missed=S[lang].list[idx].split(' ').filter((w,i)=>!marks[i]);
