@keyframes d2{to{transform:translate(-10vmax,-8vmax) scale(1.1)}}
h1,h2,h3{font-family:"Bricolage Grotesque",Figtree,system-ui,sans-serif;line-height:1.02;margin:0;letter-spacing:-.025em}
h1{font-size:clamp(3.4rem,12.5vw,7.8rem);font-weight:800}
