const DECK={},SEEN={},LAST={};
function drawIdx(l){
  const n=S[l].list.length;
  if(!DECK[l]||!DECK[l].length){
    const a=Array.from({length:n},(_,i)=>i);
    for(let i=n-1;i>0;i--){const j=Math.random()*(i+1)|0;[a[i],a[j]]=[a[j],a[i]]}
    if(n>1&&a[a.length-1]===LAST[l])[a[0],a[a.length-1]]=[a[a.length-1],a[0]];
    DECK[l]=a;
  }
  const v=DECK[l].pop();LAST[l]=v;SEEN[l]=(SEEN[l]||0)+1;return v;
}
