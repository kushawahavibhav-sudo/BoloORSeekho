h1 b{display:inline-block;font-weight:800;color:#14b8ee;text-shadow:0 5px 0 rgba(42,34,96,.1);animation:drop .9s cubic-bezier(.2,1.6,.4,1) backwards,bob 2.6s ease-in-out infinite alternate;animation-delay:calc(var(--i)*80ms),calc(1.2s + var(--i)*130ms);transition:transform .25s}
h1 b:nth-child(5n+2){color:#7a4dff}h1 b:nth-child(5n+3){color:#ff4fa3}h1 b:nth-child(5n+4){color:#ff9a2e}h1 b:nth-child(5n+5){color:#17c08a}
