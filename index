<style>
@property --p{syntax:'<number>';inherits:false;initial-value:0}
:root{--bg:#f5f6fd;--g1:#f4f5fd;--g2:#e9f0fb;--g3:#f8f0f5;--b1:#cbc3f6;--b2:#a8cdf3;--b3:#f4cfc3;--surface:rgba(255,255,255,.8);--line:rgba(100,70,200,.15);--text:#2a2260;--muted:#6d679f;--cyan:#0aa3d4;--violet:#6f45f0;--pink:#e5399f;--ok:#0f9d6b;--bad:#e03a5c;color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
